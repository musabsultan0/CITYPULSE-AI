# Application
APP_NAME=CITYPULSE AI
APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Persistence (SQLite default; swap to PostgreSQL for production)
DATABASE_URL=sqlite:///./data/citypulse.db

# City Coordinates (default: Hyderabad)
LATITUDE=17.3850
LONGITUDE=78.4867

# Live Weather Connector (Open-Meteo - no key required)
OPEN_METEO_ENABLED=false

# Real-Time Traffic API (TomTom or HERE) with automatic simulated-data fallback
# Never commit real API keys. Leave empty to use simulated fallback.
TRAFFIC_API_ENABLED=false
TRAFFIC_API_PROVIDER=tomtom
TRAFFIC_API_KEY=
TRAFFIC_API_TIMEOUT_SECONDS=10.0

# ML Model Artifacts (trained on synthetic datasets)
TRAFFIC_MODEL_PATH=./ml/traffic/models/traffic_model.joblib
FLOOD_MODEL_PATH=./ml/flood/models/flood_model.joblib
FLOOD_METRICS_PATH=./ml/flood/models/flood_metrics.json

# Embedding-Based RAG (faiss | chroma | keyword)
RAG_MODE=faiss
RAG_PERSIST_DIRECTORY=./data/vector_store
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80

# LLM Multi-Agent Reasoning (openai | gemini | ollama | openai_compatible | disabled)
# Never commit real API keys. When disabled or key missing, falls back deterministically.
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=20.0
